{
  "version": 1,
  "description": "portfolio live loop",
  "project": {
    "owner": "vuquangkhtn",
    "title": "Vuquangkhtn-portfolio board",
    "number": 3
  },
  "worker_backend": "workflow",
  "skill_sets": {
    "mode": "named",
    "named": "pstack",
    "steps": null
  },
  "agents": [
    "claude",
    "zcode"
  ],
  "other_agents": "",
  "model_tier": "medium",
  "codex": {
    "model": null
  },
  "target": {
    "type": "repo+url",
    "url": "https://vuquangkhtn.github.io"
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/vuquangkhtn/vuquangkhtn.github.io"
  },
  "base_branch": "main",
  "timezone": "Asia/Ho_Chi_Minh",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 400,
    "size_exclude": [
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/bun.lockb",
      "**/bun.lock",
      "**/npm-shrinkwrap.json",
      "**/Cargo.lock",
      "**/poetry.lock",
      "**/uv.lock",
      "**/Pipfile.lock",
      "**/Gemfile.lock",
      "**/composer.lock",
      "**/go.sum",
      "**/Podfile.lock",
      "**/pubspec.lock",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.pb.go",
      "**/*_pb2.py",
      "**/__snapshots__/**",
      "**/*.snap"
    ],
    "always_human": {
      "money": {
        "labels": [
          "money",
          "payments",
          "billing",
          "pricing"
        ],
        "paths": [
          "**/billing/**",
          "**/payments/**",
          "**/stripe/**",
          "**/checkout/**"
        ],
        "keywords": [
          "stripe.",
          "payment_intent",
          "price_id",
          "invoice.create"
        ]
      },
      "auth": {
        "labels": [
          "auth",
          "security"
        ],
        "paths": [
          "**/auth/**",
          "**/authz/**",
          "**/permissions/**"
        ],
        "keywords": [
          "jwt.sign",
          "bcrypt",
          "password_hash",
          "service_role"
        ]
      },
      "schema": {
        "labels": [
          "schema",
          "destructive"
        ],
        "paths": [],
        "keywords": [
          "drop table",
          "drop column",
          "truncate table",
          "rename column",
          "drop schema"
        ]
      }
    },
    "allow_auto_on_production": true
  },
  "migrations": {
    "globs": [
      "supabase/migrations/**",
      "prisma/migrations/**",
      "drizzle/**",
      "**/migrations/*.sql",
      "db/migrate/**",
      "alembic/versions/**"
    ],
    "allowed_envs": [],
    "target_env": "live",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "verify_commands": [
    "node -e \"const fs=require('fs');const h=fs.readFileSync('index.html','utf8');if(!h.includes('</html>'))process.exit(1);console.log('verify ok: index.html well-formed')\""
  ],
  "max_workers": 0,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "collect": {
    "sources": [
      "github"
    ],
    "window_days": 14,
    "prs": {
      "max_prs": 200
    },
    "architecture": {
      "max_findings": 5
    }
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "vuquangkhtn"
  }
}
